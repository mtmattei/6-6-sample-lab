<UserControl x:Class="A11yCapture.Presentation.Sections.ProjectionSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel>

    <TextBlock Text="DEMO · SINGLE CAPABILITY" Style="{StaticResource LabKicker}" Margin="0,0,0,12" />
    <TextBlock Text="Projection"
               Style="{StaticResource LabTitle}"
               AutomationProperties.HeadingLevel="Level1"
               Margin="0,0,0,12" />
    <TextBlock Style="{StaticResource LabLede}" MaxWidth="520" HorizontalAlignment="Left"
               Text="Skia now implements PlaneProjection and Matrix3DProjection. A projection turns an element in 3D at render time: its visual transform follows the turn, while the layout slot it was measured and arranged into stays exactly where it was." />

    <!-- Stage 1: the layout rect never moves -->
    <Border Background="{StaticResource LabGray1Brush}"
            BorderBrush="{StaticResource LabLineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource LabRadius}"
            Padding="32"
            Margin="0,32,0,0">
      <Grid>
        <TextBlock Text="FIG.14 · PLANE" Style="{StaticResource LabKicker}"
                   VerticalAlignment="Top" HorizontalAlignment="Left"
                   Margin="-20,-20,0,0" />

        <StackPanel Spacing="16">
          <Grid x:Name="PlaneStage" Height="200">
            <!-- Hairline guide sits at the card's untransformed layout rect.
                 The card turns; the guide is what it would occupy if it did not. -->
            <Rectangle Width="240" Height="140"
                       Stroke="{StaticResource LabLine2Brush}" StrokeThickness="1"
                       StrokeDashArray="3 3"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <Border x:Name="PlaneCard"
                    Width="240" Height="140"
                    Background="{StaticResource LabGray2Brush}"
                    BorderBrush="{StaticResource LabInkBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource LabRadius}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border.Projection>
                <PlaneProjection x:Name="PlaneProj" />
              </Border.Projection>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="PLANEPROJECTION" Style="{StaticResource LabKicker}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="240 × 140" Style="{StaticResource LabMonoLabel}"
                           Foreground="{StaticResource LabInkBrush}"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>

          <ToggleButton x:Name="SpinToggle"
                        Content="Animate"
                        IsChecked="True"
                        Style="{StaticResource LabToggleChip}"
                        HorizontalAlignment="Center"
                        Checked="OnSpinToggled"
                        Unchecked="OnSpinToggled" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Stage 2: the three rotation axes -->
    <Border Background="{StaticResource LabGray1Brush}"
            BorderBrush="{StaticResource LabLineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource LabRadius}"
            Padding="32"
            Margin="0,24,0,0">
      <Grid>
        <TextBlock Text="FIG.15 · AXES" Style="{StaticResource LabKicker}"
                   VerticalAlignment="Top" HorizontalAlignment="Left"
                   Margin="-20,-20,0,0" />

        <Grid ColumnSpacing="32">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="240" />
          </Grid.ColumnDefinitions>

          <Grid Height="180">
            <Border Width="200" Height="120"
                    Background="{StaticResource LabGray2Brush}"
                    BorderBrush="{StaticResource LabInkBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource LabRadius}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border.Projection>
                <PlaneProjection x:Name="AxisProj" />
              </Border.Projection>
              <TextBlock Text="X · Y · Z" Style="{StaticResource LabMonoLabel}"
                         Foreground="{StaticResource LabInkBrush}"
                         VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
          </Grid>

          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <Grid>
              <TextBlock Text="ROTATIONX" Style="{StaticResource LabKicker}" VerticalAlignment="Center" />
              <TextBlock x:Name="RotXValue" Text="0°" Style="{StaticResource LabMonoLabel}"
                         Foreground="{StaticResource LabInkBrush}" HorizontalAlignment="Right" />
            </Grid>
            <Slider x:Name="RotX" Minimum="-60" Maximum="60" Value="0" StepFrequency="1"
                    AutomationProperties.Name="Rotation X"
                    ValueChanged="OnAxisChanged" />

            <Grid Margin="0,8,0,0">
              <TextBlock Text="ROTATIONY" Style="{StaticResource LabKicker}" VerticalAlignment="Center" />
              <TextBlock x:Name="RotYValue" Text="35°" Style="{StaticResource LabMonoLabel}"
                         Foreground="{StaticResource LabInkBrush}" HorizontalAlignment="Right" />
            </Grid>
            <Slider x:Name="RotY" Minimum="-60" Maximum="60" Value="35" StepFrequency="1"
                    AutomationProperties.Name="Rotation Y"
                    ValueChanged="OnAxisChanged" />

            <Grid Margin="0,8,0,0">
              <TextBlock Text="ROTATIONZ" Style="{StaticResource LabKicker}" VerticalAlignment="Center" />
              <TextBlock x:Name="RotZValue" Text="0°" Style="{StaticResource LabMonoLabel}"
                         Foreground="{StaticResource LabInkBrush}" HorizontalAlignment="Right" />
            </Grid>
            <Slider x:Name="RotZ" Minimum="-60" Maximum="60" Value="0" StepFrequency="1"
                    AutomationProperties.Name="Rotation Z"
                    ValueChanged="OnAxisChanged" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Stage 3: the same turn, written as a matrix -->
    <Border Background="{StaticResource LabGray1Brush}"
            BorderBrush="{StaticResource LabLineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource LabRadius}"
            Padding="32"
            Margin="0,24,0,0">
      <Grid>
        <TextBlock Text="FIG.16 · MATRIX3D" Style="{StaticResource LabKicker}"
                   VerticalAlignment="Top" HorizontalAlignment="Left"
                   Margin="-20,-20,0,0" />

        <Grid ColumnSpacing="32">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="240" />
          </Grid.ColumnDefinitions>

          <Grid Height="180">
            <Border x:Name="MatrixCard"
                    Width="200" Height="120"
                    Background="{StaticResource LabGray2Brush}"
                    BorderBrush="{StaticResource LabAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource LabRadius}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border.Projection>
                <Matrix3DProjection x:Name="MatrixProj" />
              </Border.Projection>
              <TextBlock Text="M11 · M21" Style="{StaticResource LabMonoLabel}"
                         Foreground="{StaticResource LabInkBrush}"
                         VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
          </Grid>

          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <Grid>
              <TextBlock Text="Y ANGLE" Style="{StaticResource LabKicker}" VerticalAlignment="Center" />
              <TextBlock x:Name="MatrixAngleValue" Text="35°" Style="{StaticResource LabMonoLabel}"
                         Foreground="{StaticResource LabInkBrush}" HorizontalAlignment="Right" />
            </Grid>
            <Slider x:Name="MatrixAngle" Minimum="-60" Maximum="60" Value="35" StepFrequency="1"
                    AutomationProperties.Name="Matrix Y angle"
                    ValueChanged="OnMatrixChanged" />

            <Grid Margin="0,8,0,0">
              <TextBlock Text="SKEW · M21" Style="{StaticResource LabKicker}" VerticalAlignment="Center" />
              <TextBlock x:Name="SkewValue" Text="0.00" Style="{StaticResource LabMonoLabel}"
                         Foreground="{StaticResource LabInkBrush}" HorizontalAlignment="Right" />
            </Grid>
            <!-- Slider carries whole units; the handler scales it to the M21 range. -->
            <Slider x:Name="Skew" Minimum="-60" Maximum="60" Value="0" StepFrequency="5"
                    AutomationProperties.Name="Skew strength"
                    ValueChanged="OnMatrixChanged" />

            <TextBlock Style="{StaticResource LabBody}"
                       Foreground="{StaticResource LabMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Text="Matrix3DProjection takes the whole 4×4, so terms PlaneProjection never exposes are reachable. M21 shears x with y; the rotation and the shear compose in one matrix." />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Annotate -->
    <TextBlock Margin="0,16,0,0" FontSize="14" TextWrapping="Wrap">
      <Run Text="Question:"
           FontFamily="{StaticResource LabUiMediumFont}"
           Foreground="{StaticResource LabInkBrush}" />
      <Run Text=" the card turns away from you, and TransformToVisual turns with it. Did its layout slot move?"
           FontFamily="{StaticResource LabUiFont}"
           Foreground="{StaticResource LabMutedBrush}" />
    </TextBlock>

    <Rectangle Height="1" Fill="{StaticResource LabLineBrush}" Margin="0,32" />

    <!-- Live readouts -->
    <TextBlock Text="PROJECTION SURFACE" Style="{StaticResource LabKicker}" Margin="0,0,0,4" />

    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,0" Padding="0,16">
      <Grid>
        <TextBlock Text="PlaneProjection.RotationY" Style="{StaticResource LabBody}" />
        <TextBlock x:Name="SpinValue" Text="sweep ±60° / 6s"
                   Style="{StaticResource LabMonoLabel}"
                   Foreground="{StaticResource LabInkBrush}"
                   HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,0" Padding="0,16">
      <Grid>
        <TextBlock Text="Axes" Style="{StaticResource LabBody}" />
        <TextBlock x:Name="AxisSummary" Text="X 0° · Y 35° · Z 0°"
                   Style="{StaticResource LabMonoLabel}"
                   Foreground="{StaticResource LabInkBrush}"
                   HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,0" Padding="0,16">
      <Grid>
        <TextBlock Text="Matrix3D" Style="{StaticResource LabBody}" />
        <TextBlock x:Name="MatrixSummary" Text="M11 0.819 · M13 -0.574 · M34 -0.0020"
                   Style="{StaticResource LabMonoLabel}"
                   Foreground="{StaticResource LabInkBrush}"
                   HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,0" Padding="0,16">
      <Grid>
        <TextBlock Text="Matrix3D M34 (perspective) on Skia" Style="{StaticResource LabBody}" />
        <TextBlock Text="no effect · measured 6.6"
                   Style="{StaticResource LabMonoLabel}"
                   Foreground="{StaticResource LabMutedBrush}"
                   HorizontalAlignment="Right" />
      </Grid>
    </Border>

    <!-- The two rows that answer the question: one moves, one does not. -->
    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,0" Padding="0,16">
      <Grid>
        <TextBlock Text="TransformToVisual" Style="{StaticResource LabBody}" />
        <TextBlock x:Name="VisualValue" Text="—"
                   Style="{StaticResource LabMonoLabel}"
                   Foreground="{StaticResource LabMutedBrush}"
                   HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,1" Padding="0,16">
      <Grid>
        <TextBlock Text="LayoutInformation.GetLayoutSlot" Style="{StaticResource LabBody}" />
        <TextBlock x:Name="LayoutValue" Text="—"
                   Style="{StaticResource LabMonoLabel}"
                   Foreground="{StaticResource LabAccentBrush}"
                   HorizontalAlignment="Right" />
      </Grid>
    </Border>

  </StackPanel>
</UserControl>
