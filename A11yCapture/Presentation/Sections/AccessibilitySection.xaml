<UserControl x:Class="A11yCapture.Presentation.Sections.AccessibilitySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uut="using:Uno.UI.Toolkit">

  <StackPanel>

    <TextBlock Text="DEMO · SINGLE CAPABILITY" Style="{StaticResource LabKicker}" Margin="0,0,0,12" />
    <TextBlock Text="Accessibility"
               Style="{StaticResource LabTitle}"
               AutomationProperties.HeadingLevel="Level1"
               Margin="0,0,0,12" />
    <TextBlock Style="{StaticResource LabLede}" MaxWidth="520" HorizontalAlignment="Left"
               Text="Tab through the form with a screen reader running. Each control announces its name, role, value, and state from the same automation-peer tree on every target." />

    <!-- Stage -->
    <Border Background="{StaticResource LabGray1Brush}"
            BorderBrush="{StaticResource LabLineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource LabRadius}"
            Padding="32"
            Margin="0,32,0,0">
      <Grid>
        <TextBlock Text="FIG.01" Style="{StaticResource LabKicker}"
                   VerticalAlignment="Top" HorizontalAlignment="Left"
                   Margin="-20,-20,0,0" />

        <!-- Demo panel -->
        <Border MaxWidth="460"
                HorizontalAlignment="Center"
                Background="{StaticResource LabPaperBrush}"
                BorderBrush="{StaticResource LabLine2Brush}"
                BorderThickness="1"
                CornerRadius="{StaticResource LabRadius}">
          <StackPanel>

            <!-- Panel header with segmented tabs -->
            <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Form specimen"
                           FontFamily="{StaticResource LabUiSemiBoldFont}"
                           FontSize="14"
                           Foreground="{StaticResource LabInkBrush}"
                           VerticalAlignment="Center" />
                <!-- Segmented tabs: Borders stay peerless so Role fully overrides -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Right"
                        BorderBrush="{StaticResource LabLineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource LabRadius}"
                        uut:AutomationPropertiesExtensions.Role="tablist">
                  <StackPanel Orientation="Horizontal">
                    <Border uut:AutomationPropertiesExtensions.Role="tab"
                            AutomationProperties.Name="Overview"
                            Background="{StaticResource LabInkBrush}"
                            Padding="10,4">
                      <TextBlock Text="overview"
                                 FontFamily="{StaticResource LabMonoFont}" FontSize="12"
                                 Foreground="{StaticResource LabPaperBrush}" />
                    </Border>
                    <Border uut:AutomationPropertiesExtensions.Role="tab"
                            AutomationProperties.Name="Details"
                            BorderBrush="{StaticResource LabLineBrush}"
                            BorderThickness="1,0"
                            Padding="10,4">
                      <TextBlock Text="details" Style="{StaticResource LabMonoLabel}" />
                    </Border>
                    <Border uut:AutomationPropertiesExtensions.Role="tab"
                            AutomationProperties.Name="Settings"
                            Padding="10,4">
                      <TextBlock Text="settings" Style="{StaticResource LabMonoLabel}" />
                    </Border>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <!-- Panel body: the capture form -->
            <StackPanel Padding="16" Spacing="16">

              <StackPanel Spacing="6">
                <TextBlock Text="CUSTOMER NAME" Style="{StaticResource LabKicker}" />
                <TextBox AutomationProperties.Name="Customer name"
                         PlaceholderText="Contoso"
                         CornerRadius="{StaticResource LabRadius}"
                         FontFamily="{StaticResource LabUiFont}"
                         FontSize="14" />
              </StackPanel>

              <Grid>
                <TextBlock Text="WI-FI" Style="{StaticResource LabKicker}" VerticalAlignment="Center" />
                <ToggleSwitch AutomationProperties.Name="Wi-Fi"
                              HorizontalAlignment="Right"
                              Margin="0,-4" />
              </Grid>

              <StackPanel Spacing="6">
                <TextBlock Text="VOLUME" Style="{StaticResource LabKicker}" />
                <Slider AutomationProperties.Name="Volume"
                        Minimum="0" Maximum="100" Value="50" StepFrequency="5" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="CUSTOMERS" Style="{StaticResource LabKicker}" />
                <Border BorderBrush="{StaticResource LabLineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource LabRadius}">
                  <ListView AutomationProperties.Name="Customers" SelectionMode="Single"
                            Padding="12,4">
                    <x:String>Contoso</x:String>
                    <x:String>Fabrikam</x:String>
                    <x:String>Northwind</x:String>
                    <x:String>Adventure Works</x:String>
                    <x:String>Tailspin</x:String>
                  </ListView>
                </Border>
              </StackPanel>

              <Button Content="Save"
                      AutomationProperties.Name="Save"
                      Style="{StaticResource LabGhostButton}"
                      HorizontalAlignment="Left" />

            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Annotate -->
    <TextBlock Margin="0,16,0,0" FontSize="14" TextWrapping="Wrap">
      <Run Text="Question:"
           FontFamily="{StaticResource LabUiMediumFont}"
           Foreground="{StaticResource LabInkBrush}" />
      <Run Text=" what does the screen reader announce for each control?"
           FontFamily="{StaticResource LabUiFont}"
           Foreground="{StaticResource LabMutedBrush}" />
    </TextBlock>

    <Rectangle Height="1" Fill="{StaticResource LabLineBrush}" Margin="0,32" />

    <!-- The UI measures itself: UIA surface readouts -->
    <TextBlock Text="UIA SURFACE" Style="{StaticResource LabKicker}" Margin="0,0,0,4" />

    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,0" Padding="0,16">
      <Grid>
        <TextBlock Text="Tab chips" Style="{StaticResource LabBody}" />
        <TextBlock Text="role=tablist · Border peerless" Style="{StaticResource LabMonoLabel}" HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,0" Padding="0,16">
      <Grid>
        <TextBlock Text="Toggle" Style="{StaticResource LabBody}" />
        <TextBlock Text="TogglePattern · Off / On" Style="{StaticResource LabMonoLabel}" HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,0" Padding="0,16">
      <Grid>
        <TextBlock Text="Slider" Style="{StaticResource LabBody}" />
        <TextBlock Text="RangeValuePattern · 0-100 step 5" Style="{StaticResource LabMonoLabel}" HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,1" Padding="0,16">
      <Grid>
        <TextBlock Text="List" Style="{StaticResource LabBody}" />
        <TextBlock Text="ListItem · x of 5" Style="{StaticResource LabMonoLabel}" HorizontalAlignment="Right" />
      </Grid>
    </Border>

  </StackPanel>
</UserControl>
