<UserControl x:Class="A11yCapture.Presentation.Sections.InputSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:A11yCapture.Presentation.Sections">

  <UserControl.Resources>
    <local:PhaseToBrushConverter x:Key="PhaseToBrush" />

    <!-- Phase swatch settle: scale 1.06->1 + opacity 0.55->1 over 150ms on EaseSmooth, no bounce. -->
    <Storyboard x:Name="PhasePulse">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StateChipScale"
                                     Storyboard.TargetProperty="ScaleX">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.06" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.22,1 0.36,1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StateChipScale"
                                     Storyboard.TargetProperty="ScaleY">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.06" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.22,1 0.36,1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StateChip"
                                     Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.22,1 0.36,1" />
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
  </UserControl.Resources>

  <StackPanel>

    <TextBlock Text="DEMO · SINGLE CAPABILITY" Style="{StaticResource LabKicker}" Margin="0,0,0,12" />
    <TextBlock Text="Input &amp; IME"
               Style="{StaticResource LabTitle}"
               AutomationProperties.HeadingLevel="Level1"
               Margin="0,0,0,12" />
    <TextBlock Style="{StaticResource LabLede}" MaxWidth="520" HorizontalAlignment="Left"
               Text="Composed input lands in a plain TextBox with nothing to enable. The readouts below narrate the lifecycle the IME drives." />

    <!-- Stage -->
    <Border Background="{StaticResource LabGray1Brush}"
            BorderBrush="{StaticResource LabLineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource LabRadius}"
            Padding="32"
            Margin="0,32,0,0">
      <Grid>
        <TextBlock Text="FIG.03" Style="{StaticResource LabKicker}"
                   VerticalAlignment="Top" HorizontalAlignment="Left"
                   Margin="-20,-20,0,0" />

        <Border MaxWidth="460"
                HorizontalAlignment="Center"
                Background="{StaticResource LabPaperBrush}"
                BorderBrush="{StaticResource LabLine2Brush}"
                BorderThickness="1"
                CornerRadius="{StaticResource LabRadius}">
          <StackPanel Padding="16" Spacing="16">

            <StackPanel Spacing="6">
              <TextBlock Text="IME COMPOSITION" Style="{StaticResource LabKicker}" />
              <TextBox x:Name="ImeBox"
                       IsSpellCheckEnabled="False"
                       AutomationProperties.Name="Customer name"
                       PlaceholderText="Enter customer name"
                       CornerRadius="{StaticResource LabRadius}"
                       FontSize="14" />
              <TextBlock Text="{Binding ActiveImeCaption}"
                         Style="{StaticResource LabMonoLabel}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource LabLineBrush}" />

            <StackPanel Spacing="6">
              <TextBlock Text="ARABIC · RTL" Style="{StaticResource LabKicker}" />
              <TextBox x:Name="ArabicBox"
                       IsSpellCheckEnabled="False"
                       AutomationProperties.Name="Arabic"
                       FlowDirection="RightToLeft"
                       Text="مرحبا بالعالم"
                       CornerRadius="{StaticResource LabRadius}"
                       FontSize="14" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="DEVANAGARI · COMBINING MARKS" Style="{StaticResource LabKicker}" />
              <TextBox x:Name="DevanagariBox"
                       IsSpellCheckEnabled="False"
                       AutomationProperties.Name="Devanagari"
                       Text="नमस्ते दुनिया"
                       CornerRadius="{StaticResource LabRadius}"
                       FontSize="14" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="THAI · NO WORD SPACING" Style="{StaticResource LabKicker}" />
              <TextBox x:Name="ThaiBox"
                       IsSpellCheckEnabled="False"
                       AutomationProperties.Name="Thai"
                       Text="สวัสดีชาวโลก"
                       CornerRadius="{StaticResource LabRadius}"
                       FontSize="14" />
            </StackPanel>

          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Annotate -->
    <TextBlock Margin="0,16,0,0" FontSize="14" TextWrapping="Wrap">
      <Run Text="Question:"
           FontFamily="{StaticResource LabUiMediumFont}"
           Foreground="{StaticResource LabInkBrush}" />
      <Run Text=" does the caret step by grapheme cluster, and does composed input commit intact?"
           FontFamily="{StaticResource LabUiFont}"
           Foreground="{StaticResource LabMutedBrush}" />
    </TextBlock>

    <Rectangle Height="1" Fill="{StaticResource LabLineBrush}" Margin="0,32" />

    <!-- Live readouts -->
    <TextBlock Text="LIVE STATE" Style="{StaticResource LabKicker}" Margin="0,0,0,4" />

    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,0" Padding="0,16">
      <Grid>
        <TextBlock Text="State" Style="{StaticResource LabBody}" />
        <StackPanel x:Name="StateChip"
                    Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Width="14" Height="14"
                  CornerRadius="4"
                  Background="{Binding Phase, Converter={StaticResource PhaseToBrush}}"
                  BorderBrush="{StaticResource LabLineBrush}"
                  BorderThickness="1"
                  RenderTransformOrigin="0.5,0.5"
                  VerticalAlignment="Center">
            <Border.RenderTransform>
              <ScaleTransform x:Name="StateChipScale" />
            </Border.RenderTransform>
          </Border>
          <TextBlock Text="{Binding PhaseLabel}"
                     Style="{StaticResource LabMonoLabel}"
                     Foreground="{StaticResource LabInkBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,0" Padding="0,16">
      <Grid>
        <TextBlock Text="Committed" Style="{StaticResource LabBody}" />
        <TextBlock Text="{Binding CommittedText}"
                   Style="{StaticResource LabMonoLabel}"
                   Foreground="{StaticResource LabInkBrush}"
                   HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,0" Padding="0,16">
      <Grid>
        <TextBlock Text="Caret / selection" Style="{StaticResource LabBody}" />
        <TextBlock Style="{StaticResource LabMonoLabel}" HorizontalAlignment="Right">
          <Run Text="caret " /><Run Text="{Binding CaretIndex}" />
          <Run Text="  sel " /><Run Text="{Binding SelectionStart}" /><Run Text="+" /><Run Text="{Binding SelectionLength}" />
        </TextBlock>
      </Grid>
    </Border>
    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,1" Padding="0,16">
      <Grid>
        <TextBlock Text="Grapheme cluster" Style="{StaticResource LabBody}" />
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
          <TextBlock Text="{Binding ActiveGraphemeCluster}"
                     FontFamily="{StaticResource LabUiSemiBoldFont}"
                     FontSize="18"
                     Foreground="{StaticResource LabInkBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding ActiveClusterCodePoints}"
                     Style="{StaticResource LabMonoLabel}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

  </StackPanel>
</UserControl>
