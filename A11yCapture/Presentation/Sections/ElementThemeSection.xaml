<UserControl x:Class="A11yCapture.Presentation.Sections.ElementThemeSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel>

    <TextBlock Text="DEMO · SINGLE CAPABILITY" Style="{StaticResource LabKicker}" Margin="0,0,0,12" />
    <TextBlock Text="Element-level theming"
               Style="{StaticResource LabTitle}"
               AutomationProperties.HeadingLevel="Level1"
               Margin="0,0,0,12" />
    <TextBlock Style="{StaticResource LabLede}" MaxWidth="520" HorizontalAlignment="Left"
               Text="RequestedTheme applies to a subtree, not just the window. Islands resolve their own theme and nest, so a dark card can sit inside a light page." />

    <!-- Stage: three islands side by side -->
    <Border Background="{StaticResource LabGray1Brush}"
            BorderBrush="{StaticResource LabLineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource LabRadius}"
            Padding="32"
            Margin="0,32,0,0">
      <Grid>
        <TextBlock Text="FIG.04" Style="{StaticResource LabKicker}"
                   VerticalAlignment="Top" HorizontalAlignment="Left"
                   Margin="-20,-20,0,0" />

        <Grid ColumnSpacing="12" x:Name="IslandRow">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Light island -->
          <Border RequestedTheme="Light"
                  Background="{ThemeResource SurfaceBrush}"
                  BorderBrush="{ThemeResource OutlineBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource LabRadius}"
                  Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="LIGHT" Style="{StaticResource LabKicker}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              <TextBlock Text="RequestedTheme=Light"
                         FontFamily="{StaticResource LabMonoFont}" FontSize="12"
                         TextWrapping="NoWrap"
                         Foreground="{ThemeResource OnSurfaceBrush}" />
              <Button Content="Action" Style="{StaticResource LabGhostButton}"
                      HorizontalAlignment="Left" />
              <ToggleSwitch AutomationProperties.Name="Light island toggle" Margin="0,-4" />
            </StackPanel>
          </Border>

          <!-- Dark island -->
          <Border Grid.Column="1"
                  RequestedTheme="Dark"
                  Background="{ThemeResource SurfaceBrush}"
                  BorderBrush="{ThemeResource OutlineBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource LabRadius}"
                  Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="DARK" Style="{StaticResource LabKicker}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              <TextBlock Text="RequestedTheme=Dark"
                         FontFamily="{StaticResource LabMonoFont}" FontSize="12"
                         TextWrapping="NoWrap"
                         Foreground="{ThemeResource OnSurfaceBrush}" />
              <Button Content="Action"
                      Background="{ThemeResource SurfaceVariantBrush}"
                      Foreground="{ThemeResource OnSurfaceBrush}"
                      BorderBrush="{ThemeResource OutlineBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource LabRadius}"
                      FontFamily="{StaticResource LabUiMediumFont}"
                      FontSize="14"
                      Padding="16,7"
                      HorizontalAlignment="Left" />
              <ToggleSwitch AutomationProperties.Name="Dark island toggle" Margin="0,-4" />
            </StackPanel>
          </Border>

          <!-- Matryoshka: island that inherits, holding a nested opposite -->
          <Border x:Name="NestedHost"
                  Grid.Column="2"
                  Background="{ThemeResource SurfaceBrush}"
                  BorderBrush="{ThemeResource OutlineBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource LabRadius}"
                  Padding="16">
            <StackPanel Spacing="10">
              <TextBlock x:Name="NestedHostLabel"
                         Text="INHERITED" Style="{StaticResource LabKicker}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              <TextBlock Text="No RequestedTheme set"
                         FontFamily="{StaticResource LabMonoFont}" FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="{ThemeResource OnSurfaceBrush}" />
              <Border x:Name="NestedIsland"
                      RequestedTheme="Dark"
                      Background="{ThemeResource SurfaceBrush}"
                      BorderBrush="{ThemeResource OutlineBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource LabRadius}"
                      Padding="12">
                <StackPanel Spacing="6">
                  <TextBlock x:Name="NestedIslandLabel"
                             Text="NESTED · DARK" Style="{StaticResource LabKicker}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="A subtree inside a subtree"
                             FontFamily="{StaticResource LabUiFont}" FontSize="12"
                             TextWrapping="Wrap"
                             Foreground="{ThemeResource OnSurfaceBrush}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

        </Grid>
      </Grid>
    </Border>

    <!-- Section-level switcher -->
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,20,0,0" VerticalAlignment="Center">
      <TextBlock Text="SECTION THEME" Style="{StaticResource LabKicker}" VerticalAlignment="Center" />
      <Border BorderBrush="{StaticResource LabLineBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource LabRadius}">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ThemeDefaultButton" Content="default" Tag="Default"
                  Style="{StaticResource LabSegButton}" Click="ThemeButton_Click" />
          <Button x:Name="ThemeLightButton" Content="light" Tag="Light"
                  Style="{StaticResource LabSegButton}" Click="ThemeButton_Click" />
          <Button x:Name="ThemeDarkButton" Content="dark" Tag="Dark"
                  Style="{StaticResource LabSegButton}" Click="ThemeButton_Click" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Annotate -->
    <TextBlock Margin="0,16,0,0" FontSize="14" TextWrapping="Wrap">
      <Run Text="Question:"
           FontFamily="{StaticResource LabUiMediumFont}"
           Foreground="{StaticResource LabInkBrush}" />
      <Run Text=" which island moves when the section theme changes, and which holds its own?"
           FontFamily="{StaticResource LabUiFont}"
           Foreground="{StaticResource LabMutedBrush}" />
    </TextBlock>

    <Rectangle Height="1" Fill="{StaticResource LabLineBrush}" Margin="0,32" />

    <!-- Live readouts -->
    <TextBlock Text="LIVE STATE" Style="{StaticResource LabKicker}" Margin="0,0,0,4" />

    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,0" Padding="0,16">
      <Grid>
        <TextBlock Text="Section RequestedTheme" Style="{StaticResource LabBody}" />
        <TextBlock x:Name="RequestedValue" Text="Default" Style="{StaticResource LabMonoLabel}"
                   Foreground="{StaticResource LabInkBrush}" HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,0" Padding="0,16">
      <Grid>
        <TextBlock Text="Section ActualTheme" Style="{StaticResource LabBody}" />
        <TextBlock x:Name="ActualValue" Text="Light" Style="{StaticResource LabMonoLabel}"
                   Foreground="{StaticResource LabInkBrush}" HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <Border BorderBrush="{StaticResource LabLineBrush}" BorderThickness="0,1,0,1" Padding="0,16">
      <Grid>
        <TextBlock Text="Nested island" Style="{StaticResource LabBody}" />
        <TextBlock x:Name="NestedValue" Text="Dark (opposite of inherited)"
                   Style="{StaticResource LabMonoLabel}" HorizontalAlignment="Right" />
      </Grid>
    </Border>

  </StackPanel>
</UserControl>
