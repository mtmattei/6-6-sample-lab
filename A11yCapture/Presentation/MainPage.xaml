<Page x:Class="A11yCapture.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uut="using:Uno.UI.Toolkit"
      xmlns:sections="using:A11yCapture.Presentation.Sections"
      NavigationCacheMode="Required"
      Background="{StaticResource LabPaperBrush}">

  <Page.Resources>
    <!-- One quadrant of the Uno Platform knot fills at a time: 600ms each, 2.4s loop.
         Discrete brush swaps; loop is gated on AnimationsEnabled in code-behind. -->
    <Storyboard x:Name="LogoQuadrantLoop" RepeatBehavior="Forever">
      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LogoArmTop" Storyboard.TargetProperty="Fill">
        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{StaticResource LabInkBrush}" />
        <DiscreteObjectKeyFrame KeyTime="0:0:0.6" Value="Transparent" />
      </ObjectAnimationUsingKeyFrames>
      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LogoArmRight" Storyboard.TargetProperty="Fill">
        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Transparent" />
        <DiscreteObjectKeyFrame KeyTime="0:0:0.6" Value="{StaticResource LabInkBrush}" />
        <DiscreteObjectKeyFrame KeyTime="0:0:1.2" Value="Transparent" />
      </ObjectAnimationUsingKeyFrames>
      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LogoArmBottom" Storyboard.TargetProperty="Fill">
        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Transparent" />
        <DiscreteObjectKeyFrame KeyTime="0:0:1.2" Value="{StaticResource LabInkBrush}" />
        <DiscreteObjectKeyFrame KeyTime="0:0:1.8" Value="Transparent" />
      </ObjectAnimationUsingKeyFrames>
      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LogoArmLeft" Storyboard.TargetProperty="Fill">
        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Transparent" />
        <DiscreteObjectKeyFrame KeyTime="0:0:1.8" Value="{StaticResource LabInkBrush}" />
      </ObjectAnimationUsingKeyFrames>
    </Storyboard>
  </Page.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="49" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Brand -->
    <Border Grid.Row="0" Grid.Column="0"
            BorderBrush="{StaticResource LabLineBrush}"
            BorderThickness="0,0,1,1"
            Padding="16,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <!-- Uno Platform knot: outline arms, one quadrant filled at a time -->
        <Viewbox Width="20" Height="20" VerticalAlignment="Center"
                 AutomationProperties.AccessibilityView="Raw">
          <Grid>
            <Path x:Name="LogoArmTop"
                  Stroke="{StaticResource LabInkBrush}" StrokeThickness="10"
                  Fill="{StaticResource LabInkBrush}"
                  Data="M131.802 110.464L156.865 85.1239C168.742 73.2472 173.363 66.2918 173.377 60.3051C173.391 54.3183 168.521 46.9293 156.57 34.965L142.733 21.2895C128.652 7.20808 120.133 10.4229 109.271 21.2618L109.137 21.391C103.187 26.9811 96.633 33.6689 92.3481 40.735C88.3677 41.0164 83.2342 42.3724 76.9199 46.5973C80.4161 33.4844 91.3472 21.7968 100.904 12.789C111.692 2.02384 128.615 -9.61765 151.091 12.8536L164.928 26.5291C177.496 39.0976 185.263 49.1294 185.222 60.3281C185.222 71.3469 177.565 81.1942 165.246 93.5091L140.261 118.835L131.802 110.464Z" />
            <Path x:Name="LogoArmRight"
                  Stroke="{StaticResource LabInkBrush}" StrokeThickness="10"
                  Fill="Transparent"
                  Data="M167.935 150.07H167.889C156.87 150.047 147.023 142.409 134.708 130.094L107.957 103.555L116.319 95.1049L143.107 121.667C154.979 133.544 161.93 138.165 167.921 138.179C173.973 138.179 181.297 133.309 193.243 121.372L206.918 107.535C213.805 100.644 216.839 94.6206 216.217 89.1458C215.709 84.681 212.767 79.8935 206.941 74.0727L206.817 73.939C200.53 67.2557 192.842 59.7976 184.812 55.6696C183.322 48.0362 178.433 42.0263 177.741 40.9102C192.427 43.0687 205.53 55.2083 215.419 65.7152C226.184 76.5034 237.826 93.426 215.35 115.902L201.679 129.739C189.152 142.303 179.129 150.07 167.935 150.07Z" />
            <Path x:Name="LogoArmBottom"
                  Stroke="{StaticResource LabInkBrush}" StrokeThickness="10"
                  Fill="Transparent"
                  Data="M135.358 192.398C127.923 192.398 119.473 188.975 110.037 179.539L96.1996 165.868C69.1392 138.807 69.0792 125.667 95.8583 98.8877L122.121 72.353L130.575 80.7152L104.285 107.287C92.4083 119.163 87.7822 126.119 87.7729 132.106C87.7637 138.092 92.6297 145.481 104.58 157.446L118.417 171.121C132.499 185.198 141.018 181.992 151.88 171.149L152.013 171.02C158.397 165.024 165.523 157.667 169.743 150.029C176.159 149.485 180.946 146.777 184.553 144.494C181.468 158.151 170.121 170.323 160.223 179.64C153.96 185.876 145.634 192.398 135.358 192.398Z" />
            <Path x:Name="LogoArmLeft"
                  Stroke="{StaticResource LabInkBrush}" StrokeThickness="10"
                  Fill="Transparent"
                  Data="M82.0809 149.439C68.244 146.501 55.9153 135.016 46.5015 124.994C41.5848 120.068 34.9707 112.439 33.8869 102.91C32.8352 93.5883 36.9817 84.3959 46.5661 74.8069L60.2416 60.97C72.7917 48.4199 82.8051 40.6758 93.9946 40.6758H94.0407C105.059 40.6758 114.907 48.3322 127.222 60.6471L154.434 87.5876L146.072 96.0374L118.86 69.0784C106.96 57.1925 100.004 52.5802 94.0176 52.5802H93.9946C87.9478 52.5802 80.6188 57.4508 68.6776 69.3874L55.002 83.2244C48.1158 90.1152 45.0809 96.1389 45.7036 101.609C46.211 106.074 49.1536 110.866 54.9744 116.687L55.1035 116.816C61.0995 123.185 68.3455 130.252 75.9604 134.476C76.6107 141.197 80.5958 147.211 82.0809 149.439Z" />
          </Grid>
        </Viewbox>
        <TextBlock Text="SAMPLE LAB"
                   FontFamily="{StaticResource LabMonoMediumFont}"
                   FontSize="12"
                   CharacterSpacing="140"
                   Foreground="{StaticResource LabInkBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Top bar -->
    <Border Grid.Row="0" Grid.Column="1"
            BorderBrush="{StaticResource LabLineBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,0">
      <Grid VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="lab" Style="{StaticResource LabMonoLabel}" />
          <TextBlock Text="/" Style="{StaticResource LabMonoLabel}" Foreground="{StaticResource LabLine2Brush}" />
          <TextBlock x:Name="CrumbText"
                     Text="index"
                     FontFamily="{StaticResource LabMonoMediumFont}"
                     FontSize="12"
                     CharacterSpacing="40"
                     Foreground="{StaticResource LabInkBrush}" />
        </StackPanel>
        <TextBlock Text="v0.1 · uno platform 6.6"
                   Style="{StaticResource LabMonoLabel}"
                   Foreground="{StaticResource LabLine2Brush}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Sidebar nav -->
    <Border Grid.Row="1" Grid.Column="0"
            BorderBrush="{StaticResource LabLineBrush}"
            BorderThickness="0,0,1,0"
            Padding="12,16"
            uut:AutomationPropertiesExtensions.Role="navigation">
      <StackPanel Spacing="4">
        <TextBlock Text="OVERVIEW" Style="{StaticResource LabKicker}" Margin="8,0,8,8" />

        <Button x:Name="NavHome"
                Style="{StaticResource LabNavItem}"
                Background="{StaticResource LabGray1Brush}"
                AutomationProperties.Name="Index"
                Click="NavItem_Click">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Rectangle x:Name="TickHome" Width="2" Height="14" RadiusX="1" RadiusY="1"
                       Fill="{StaticResource LabAccentBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="LabelHome"
                       Text="Index"
                       FontFamily="{StaticResource LabUiMediumFont}"
                       FontSize="14"
                       Foreground="{StaticResource LabInkBrush}" />
          </StackPanel>
        </Button>

        <TextBlock Text="DEMOS" Style="{StaticResource LabKicker}" Margin="8,24,8,8" />

        <Button x:Name="NavAccessibility"
                Style="{StaticResource LabNavItem}"
                AutomationProperties.Name="Accessibility"
                Click="NavItem_Click">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Rectangle x:Name="TickAccessibility" Width="2" Height="14" RadiusX="1" RadiusY="1"
                       Fill="Transparent" VerticalAlignment="Center" />
            <TextBlock x:Name="LabelAccessibility"
                       Text="Accessibility"
                       FontFamily="{StaticResource LabUiFont}"
                       FontSize="14"
                       Foreground="{StaticResource LabMutedBrush}" />
          </StackPanel>
        </Button>

        <Button x:Name="NavScrollAnchor"
                Style="{StaticResource LabNavItem}"
                AutomationProperties.Name="Scroll anchoring"
                Click="NavItem_Click">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Rectangle x:Name="TickScrollAnchor" Width="2" Height="14" RadiusX="1" RadiusY="1"
                       Fill="Transparent" VerticalAlignment="Center" />
            <TextBlock x:Name="LabelScrollAnchor"
                       Text="Scroll Anchoring"
                       FontFamily="{StaticResource LabUiFont}"
                       FontSize="14"
                       Foreground="{StaticResource LabMutedBrush}" />
          </StackPanel>
        </Button>

        <Button x:Name="NavInput"
                Style="{StaticResource LabNavItem}"
                AutomationProperties.Name="Input and IME"
                Click="NavItem_Click">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Rectangle x:Name="TickInput" Width="2" Height="14" RadiusX="1" RadiusY="1"
                       Fill="Transparent" VerticalAlignment="Center" />
            <TextBlock x:Name="LabelInput"
                       Text="Input &amp; IME"
                       FontFamily="{StaticResource LabUiFont}"
                       FontSize="14"
                       Foreground="{StaticResource LabMutedBrush}" />
          </StackPanel>
        </Button>

        <Button x:Name="NavText"
                Style="{StaticResource LabNavItem}"
                AutomationProperties.Name="Text features"
                Click="NavItem_Click">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Rectangle x:Name="TickText" Width="2" Height="14" RadiusX="1" RadiusY="1"
                       Fill="Transparent" VerticalAlignment="Center" />
            <TextBlock x:Name="LabelText"
                       Text="Text Features"
                       FontFamily="{StaticResource LabUiFont}"
                       FontSize="14"
                       Foreground="{StaticResource LabMutedBrush}" />
          </StackPanel>
        </Button>

        <Button x:Name="NavElementTheme"
                Style="{StaticResource LabNavItem}"
                AutomationProperties.Name="Element theming"
                Click="NavItem_Click">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Rectangle x:Name="TickElementTheme" Width="2" Height="14" RadiusX="1" RadiusY="1"
                       Fill="Transparent" VerticalAlignment="Center" />
            <TextBlock x:Name="LabelElementTheme"
                       Text="Element Theming"
                       FontFamily="{StaticResource LabUiFont}"
                       FontSize="14"
                       Foreground="{StaticResource LabMutedBrush}" />
          </StackPanel>
        </Button>

        <Button x:Name="NavVectorGraphics"
                Style="{StaticResource LabNavItem}"
                AutomationProperties.Name="Vector graphics"
                Click="NavItem_Click">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Rectangle x:Name="TickVectorGraphics" Width="2" Height="14" RadiusX="1" RadiusY="1"
                       Fill="Transparent" VerticalAlignment="Center" />
            <TextBlock x:Name="LabelVectorGraphics"
                       Text="Vector Graphics"
                       FontFamily="{StaticResource LabUiFont}"
                       FontSize="14"
                       Foreground="{StaticResource LabMutedBrush}" />
          </StackPanel>
        </Button>

        <Button x:Name="NavProjection"
                Style="{StaticResource LabNavItem}"
                AutomationProperties.Name="Projection"
                Click="NavItem_Click">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Rectangle x:Name="TickProjection" Width="2" Height="14" RadiusX="1" RadiusY="1"
                       Fill="Transparent" VerticalAlignment="Center" />
            <TextBlock x:Name="LabelProjection"
                       Text="Projection"
                       FontFamily="{StaticResource LabUiFont}"
                       FontSize="14"
                       Foreground="{StaticResource LabMutedBrush}" />
          </StackPanel>
        </Button>

        <Button x:Name="NavMenuFlyout"
                Style="{StaticResource LabNavItem}"
                AutomationProperties.Name="Menus and context"
                Click="NavItem_Click">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Rectangle x:Name="TickMenuFlyout" Width="2" Height="14" RadiusX="1" RadiusY="1"
                       Fill="Transparent" VerticalAlignment="Center" />
            <TextBlock x:Name="LabelMenuFlyout"
                       Text="Menus &amp; Context"
                       FontFamily="{StaticResource LabUiFont}"
                       FontSize="14"
                       Foreground="{StaticResource LabMutedBrush}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- Main -->
    <ScrollViewer x:Name="MainScroll" Grid.Row="1" Grid.Column="1" IsTabStop="False">
      <Grid MaxWidth="760"
            HorizontalAlignment="Left"
            Padding="48,48,48,64"
            AutomationProperties.LandmarkType="Main">
        <sections:HomeSection x:Name="HomeView" SampleSelected="OnSampleSelected" />
        <sections:AccessibilitySection x:Name="AccessibilityView" Visibility="Collapsed" />
        <sections:ScrollAnchorSection x:Name="ScrollAnchorView" Visibility="Collapsed" />
        <sections:InputSection x:Name="InputView" Visibility="Collapsed" />
        <sections:TextSection x:Name="TextView" Visibility="Collapsed" />
        <sections:ElementThemeSection x:Name="ElementThemeView" Visibility="Collapsed" />
        <sections:VectorGraphicsSection x:Name="VectorGraphicsView" Visibility="Collapsed" />
        <sections:ProjectionSection x:Name="ProjectionView" Visibility="Collapsed" />
        <sections:MenuFlyoutSection x:Name="MenuFlyoutView" Visibility="Collapsed" />
      </Grid>
    </ScrollViewer>

    <!-- Source panel: curated excerpts for the active demo. Hidden on the index. -->
    <Border x:Name="SourcePanel"
            Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
            Width="392"
            Visibility="Collapsed"
            BorderBrush="{StaticResource LabLineBrush}"
            BorderThickness="1,0,0,0"
            uut:AutomationPropertiesExtensions.Role="complementary"
            AutomationProperties.Name="Sample source">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="49" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tab header, aligned with the top bar -->
        <Border BorderBrush="{StaticResource LabLineBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
          <Grid>
            <Button x:Name="CollapseSourceBtn"
                    Content="HIDE &#x203A;"
                    Style="{StaticResource LabSegButton}"
                    Background="Transparent"
                    Padding="2,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    FontFamily="{StaticResource LabMonoFont}"
                    Foreground="{StaticResource LabMutedBrush}"
                    AutomationProperties.Name="Hide source panel"
                    Click="CollapseSource_Click" />
            <StackPanel Orientation="Horizontal" Spacing="20">
            <Grid>
              <Button x:Name="TabXamlBtn"
                      Content="XAML"
                      Style="{StaticResource LabSegButton}"
                      Background="Transparent"
                      Padding="2,0"
                      VerticalAlignment="Stretch"
                      FontFamily="{StaticResource LabMonoMediumFont}"
                      Foreground="{StaticResource LabInkBrush}"
                      AutomationProperties.Name="XAML source"
                      Click="SourceTab_Click" />
              <Rectangle x:Name="TabXamlLine" Height="2"
                         Fill="{StaticResource LabInkBrush}"
                         VerticalAlignment="Bottom" />
            </Grid>
            <Grid>
              <Button x:Name="TabCSharpBtn"
                      Content="C#"
                      Style="{StaticResource LabSegButton}"
                      Background="Transparent"
                      Padding="2,0"
                      VerticalAlignment="Stretch"
                      AutomationProperties.Name="C# source"
                      Click="SourceTab_Click" />
              <Rectangle x:Name="TabCSharpLine" Height="2"
                         Fill="Transparent"
                         VerticalAlignment="Bottom" />
            </Grid>
            <Grid>
              <Button x:Name="TabNotesBtn"
                      Content="NOTES"
                      Style="{StaticResource LabSegButton}"
                      Background="Transparent"
                      Padding="2,0"
                      VerticalAlignment="Stretch"
                      AutomationProperties.Name="Notes"
                      Click="SourceTab_Click" />
              <Rectangle x:Name="TabNotesLine" Height="2"
                         Fill="Transparent"
                         VerticalAlignment="Bottom" />
            </Grid>
          </StackPanel>
          </Grid>
        </Border>

        <!-- Code: one row per line (gutter + wrapped text), built in code-behind
             so wrapped continuations stay aligned under the code column -->
        <ScrollViewer x:Name="CodeScroll"
                      Grid.Row="1"
                      Padding="24,24,24,12"
                      VerticalScrollBarVisibility="Auto"
                      IsTabStop="False">
          <StackPanel x:Name="CodeHost" />
        </ScrollViewer>

        <Button x:Name="CopyButton"
                Grid.Row="2"
                Style="{StaticResource LabGhostButton}"
                Padding="12,5"
                Margin="24,8,24,20"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Copy source"
                Click="CopySource_Click">
          <TextBlock x:Name="CopyLabel"
                     Text="COPY"
                     FontFamily="{StaticResource LabMonoFont}"
                     FontSize="11"
                     CharacterSpacing="80" />
        </Button>

        <!-- Tip footer -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource LabLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,20">
          <StackPanel Spacing="6">
            <TextBlock Text="TIP" Style="{StaticResource LabKicker}" />
            <TextBlock x:Name="TipText"
                       Style="{StaticResource LabMonoLabel}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Collapsed stand-in for the source panel: a slim rail with a reopen affordance.
         Shown only when a sample is active and the panel is hidden. -->
    <Border x:Name="SourceRail"
            Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
            Width="41"
            Visibility="Collapsed"
            BorderBrush="{StaticResource LabLineBrush}"
            BorderThickness="1,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="49" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource LabLineBrush}"
                BorderThickness="0,0,0,1" />
        <Button x:Name="ExpandSourceBtn"
                Grid.RowSpan="2"
                Content="&#x2039;/&#x203A;"
                Style="{StaticResource LabSegButton}"
                Background="Transparent"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                FontFamily="{StaticResource LabMonoFont}"
                Foreground="{StaticResource LabMutedBrush}"
                AutomationProperties.Name="Show source panel"
                Click="ExpandSource_Click" />
      </Grid>
    </Border>

  </Grid>
</Page>
