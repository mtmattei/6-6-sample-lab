<!-- Sample Lab design tokens and styles.
     Plain root-level dictionary (not a theme dictionary) so custom keys
     resolve inside DataTemplates on Skia targets. Light-only system. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- MenuBar / MenuFlyout come from WinUI resources, not Material, and their default
       foreground resolves near-white against paper. These must live in a theme
       dictionary: the templates read them with {ThemeResource}, which resolves against
       ThemeDictionaries and ignores plain root-level entries. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="MenuBarItemForeground" Color="#14161A" />
      <SolidColorBrush x:Key="MenuBarItemForegroundPointerOver" Color="#14161A" />
      <SolidColorBrush x:Key="MenuBarItemForegroundPressed" Color="#14161A" />
      <SolidColorBrush x:Key="MenuBarItemForegroundSelected" Color="#14161A" />
      <SolidColorBrush x:Key="MenuBarItemBackgroundPointerOver" Color="#F6F7F8" />
      <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="#EDEEF1" />
      <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="#EDEEF1" />
      <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#14161A" />
      <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#14161A" />
      <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#14161A" />
      <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#6B7077" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemForeground" Color="#14161A" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundPointerOver" Color="#14161A" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="MenuBarItemForeground" Color="#F6F7F8" />
      <SolidColorBrush x:Key="MenuBarItemForegroundPointerOver" Color="#F6F7F8" />
      <SolidColorBrush x:Key="MenuBarItemForegroundPressed" Color="#F6F7F8" />
      <SolidColorBrush x:Key="MenuBarItemForegroundSelected" Color="#F6F7F8" />
      <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#F6F7F8" />
      <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#F6F7F8" />
      <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#9BA1A9" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemForeground" Color="#F6F7F8" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Ink and neutrals -->
  <Color x:Key="LabPaperColor">#FFFFFF</Color>
  <Color x:Key="LabGray1Color">#F6F7F8</Color>
  <Color x:Key="LabGray2Color">#EDEEF1</Color>
  <Color x:Key="LabLineColor">#E2E4E8</Color>
  <Color x:Key="LabLine2Color">#C9CCD2</Color>
  <Color x:Key="LabInkColor">#14161A</Color>
  <Color x:Key="LabMutedColor">#6B7077</Color>
  <Color x:Key="LabAccentColor">#3656D4</Color>

  <SolidColorBrush x:Key="LabPaperBrush" Color="{StaticResource LabPaperColor}" />
  <SolidColorBrush x:Key="LabGray1Brush" Color="{StaticResource LabGray1Color}" />
  <SolidColorBrush x:Key="LabGray2Brush" Color="{StaticResource LabGray2Color}" />
  <SolidColorBrush x:Key="LabLineBrush" Color="{StaticResource LabLineColor}" />
  <SolidColorBrush x:Key="LabLine2Brush" Color="{StaticResource LabLine2Color}" />
  <SolidColorBrush x:Key="LabInkBrush" Color="{StaticResource LabInkColor}" />
  <SolidColorBrush x:Key="LabMutedBrush" Color="{StaticResource LabMutedColor}" />
  <SolidColorBrush x:Key="LabAccentBrush" Color="{StaticResource LabAccentColor}" />
  <SolidColorBrush x:Key="LabAccentSoftBrush" Color="{StaticResource LabAccentColor}" Opacity="0.10" />

  <!-- Type: Inter for interface, JetBrains Mono for labels and readouts.
       Static instances per weight; family fragment matches each file's name table. -->
  <FontFamily x:Key="LabUiFont">ms-appx:///Assets/Fonts/Inter-400.ttf#Inter</FontFamily>
  <FontFamily x:Key="LabUiMediumFont">ms-appx:///Assets/Fonts/Inter-500.ttf#Inter Medium</FontFamily>
  <FontFamily x:Key="LabUiSemiBoldFont">ms-appx:///Assets/Fonts/Inter-600.ttf#Inter SemiBold</FontFamily>
  <FontFamily x:Key="LabMonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-400.ttf#JetBrains Mono</FontFamily>
  <FontFamily x:Key="LabMonoMediumFont">ms-appx:///Assets/Fonts/JetBrainsMono-500.ttf#JetBrains Mono Medium</FontFamily>

  <CornerRadius x:Key="LabRadius">4</CornerRadius>

  <!-- Text styles: hierarchy from scale and rhythm, not weight or color -->
  <Style x:Key="LabTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource LabUiSemiBoldFont}" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="CharacterSpacing" Value="-15" />
    <Setter Property="Foreground" Value="{StaticResource LabInkBrush}" />
    <Setter Property="LineHeight" Value="37" />
  </Style>

  <Style x:Key="LabLede" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource LabUiFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource LabMutedBrush}" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="LabBody" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource LabUiFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource LabInkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Uppercase supplied in markup; XAML has no text-transform -->
  <Style x:Key="LabKicker" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource LabMonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CharacterSpacing" Value="120" />
    <Setter Property="Foreground" Value="{StaticResource LabMutedBrush}" />
  </Style>

  <Style x:Key="LabMonoLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource LabMonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CharacterSpacing" Value="40" />
    <Setter Property="Foreground" Value="{StaticResource LabMutedBrush}" />
  </Style>

  <!-- Ghost button: paper fill, hairline border, ink text -->
  <Style x:Key="LabGhostButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource LabPaperBrush}" />
    <Setter Property="Foreground" Value="{StaticResource LabInkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LabLine2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LabRadius}" />
    <Setter Property="FontFamily" Value="{StaticResource LabUiMediumFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="16,7" />
  </Style>

  <!-- Sidebar nav item: bare button, hover = gray-1, active state set from code -->
  <Style x:Key="LabNavItem" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="CornerRadius" Value="{StaticResource LabRadius}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource LabGray1Brush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource LabGray2Brush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toggle chip: outlined idle, ink-inverted when checked -->
  <Style x:Key="LabToggleChip" TargetType="ToggleButton">
    <Setter Property="Background" Value="{StaticResource LabPaperBrush}" />
    <Setter Property="Foreground" Value="{StaticResource LabInkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LabLine2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource LabRadius}" />
    <Setter Property="FontFamily" Value="{StaticResource LabUiMediumFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter x:Name="CP"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource LabGray1Brush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource LabGray2Brush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource LabInkBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{StaticResource LabInkBrush}" />
                    <Setter Target="CP.Foreground" Value="{StaticResource LabPaperBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource LabInkBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{StaticResource LabInkBrush}" />
                    <Setter Target="CP.Foreground" Value="{StaticResource LabPaperBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource LabInkBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{StaticResource LabInkBrush}" />
                    <Setter Target="CP.Foreground" Value="{StaticResource LabPaperBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menu-bar button: flat, ink text, gray-1 on hover. Hosts a MenuFlyout.
       Used instead of MenuBar, whose WinUI chrome renders its titles unreadably
       on this Skia build (see the section comment). -->
  <Style x:Key="LabMenuButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource LabInkBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource LabUiFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="{StaticResource LabRadius}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource LabGray1Brush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{StaticResource LabGray2Brush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control button: mono 12, on = ink invert (set from code) -->
  <Style x:Key="LabSegButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource LabPaperBrush}" />
    <Setter Property="Foreground" Value="{StaticResource LabMutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource LabMonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}">
            <ContentPresenter Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.75" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.6" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- IME phase ramp: state reads by darkness; candidate uses the accent (state colour) -->
  <SolidColorBrush x:Key="PhaseIdleBrush" Color="{StaticResource LabLine2Color}" />
  <SolidColorBrush x:Key="PhaseComposingBrush" Color="{StaticResource LabMutedColor}" />
  <SolidColorBrush x:Key="PhaseCandidateBrush" Color="{StaticResource LabAccentColor}" />
  <SolidColorBrush x:Key="PhaseCommittedBrush" Color="{StaticResource LabInkColor}" />

</ResourceDictionary>
